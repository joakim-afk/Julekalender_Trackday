# Kopier disse inn i Vercel > Project > Settings > Environment Variables

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend > API Keys. Avsenderdomenet må være verifisert i Resend.
RESEND_API_KEY=
EMAIL_FROM=Trackday Julekalender <julekalender@trackday.no>
EMAIL_REPLY_TO=post@trackday.no

# Hvem som får e-post når en vinner er trukket (flere skilles med komma)
ADMIN_EMAIL=

# Lang tilfeldig tekst. Vercel bruker den til å starte den daglige jobben.
CRON_SECRET=

# Adressen kalenderen ligger på (brukes i lenker i e-postene)
SITE_URL=https://julekalender.trackday.no

# Av/på (true/false)
# Daglig påminnelse til «Varsle meg»-listen kl. 07:00
SEND_REMINDERS=true
# true = vinneren får «Gratulerer»-e-post automatisk
NOTIFY_WINNER=false
# true = samme person kan vinne flere luker
ALLOW_REPEAT_WINNERS=false
# true = alle luker tar imot påmeldinger (kun for testing, husk å sette tilbake!)
ALLOW_ANY_DOOR=false

# Valgfritt
# CAMPAIGN_YEAR=2026
# LAST_DRAW_DAY=27
